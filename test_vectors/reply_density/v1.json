{
  "schemaVersion": 1,
  "candidateTypes": [
    "none",
    "singlePureMention",
    "multiplePureMentions",
    "shortText",
    "pureEmote",
    "pureImage"
  ],
  "cases": [
    {
      "caseId": "single_real_mention_fold_disabled",
      "description": "A verified single pure mention is detected but not folded when the switch is off.",
      "coverage": [
        "singlePureMention",
        "realMentionValidation"
      ],
      "input": {
        "message": "@主账号",
        "atNameToMid": {
          "主账号": 1001
        },
        "structuredEmotes": [],
        "hasPictures": false,
        "nickname": "",
        "repeatedMentionCount": 0,
        "config": {
          "foldPureMentions": false,
          "multipleMentionThreshold": 2,
          "shortTextMaxCharacters": 4
        }
      },
      "expected": {
        "candidateType": "singlePureMention",
        "mentionOccurrenceCount": 1,
        "distinctMentionMidCount": 1,
        "effectiveTextLength": 0,
        "shouldFold": false,
        "pendingReview": false,
        "shouldPermanentlyBlock": false,
        "aiSignals": [],
        "matchesBalancedAiFilter": false,
        "reasonLabels": [
          "singlePureMention"
        ]
      }
    },
    {
      "caseId": "single_real_mention_fold_enabled",
      "description": "The same verified mention is recoverably folded only after opt-in.",
      "coverage": [
        "singlePureMention",
        "foldSwitch"
      ],
      "input": {
        "message": "  @主账号！ ",
        "atNameToMid": {
          "主账号": 1001
        },
        "structuredEmotes": [],
        "hasPictures": false,
        "nickname": "",
        "repeatedMentionCount": 0,
        "config": {
          "foldPureMentions": true,
          "multipleMentionThreshold": 2,
          "shortTextMaxCharacters": 4
        }
      },
      "expected": {
        "candidateType": "singlePureMention",
        "mentionOccurrenceCount": 1,
        "distinctMentionMidCount": 1,
        "effectiveTextLength": 0,
        "shouldFold": true,
        "pendingReview": false,
        "shouldPermanentlyBlock": false,
        "aiSignals": [],
        "matchesBalancedAiFilter": false,
        "reasonLabels": [
          "singlePureMention"
        ]
      }
    },
    {
